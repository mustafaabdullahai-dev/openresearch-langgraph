# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS (no wildcard with cookies).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- LLM backend ----
# "hf" = Hugging Face hosted inference (default).
# Requires enabling an inference provider in your HF account:
#   https://huggingface.co/settings/inference-providers
LLM_PROVIDER=hf
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Optional: point HF_BASE_URL at your own vLLM/TGI endpoint.
HF_BASE_URL=

# ---- Database ----
DATABASE_URL=sqlite:///./data/openresearch.db

# ---- Vector store ----
VECTOR_DB_PATH=./data/chroma

# ---- Research loop ----
MAX_RESEARCH_ITERATIONS=3
MAX_SEARCH_RESULTS=5
MAX_REPORT_REVISIONS=2

# ---- Search provider (free-first: duckduckgo, optional: tavily) ----
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
