# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS (no wildcard with cookies).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- LLM backend ----
# "openai" = any OpenAI-compatible endpoint (default; Groq, Together, vLLM...)
# "hf"     = Hugging Face hosted inference (alternative)
LLM_PROVIDER=openai

# ---- OpenAI-compatible endpoint (defaults to Groq) ----
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3.6-27b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Per-call output cap; keep under the free-tier rate window (1000 OTPM on Groq).
OPENAI_MAX_TOKENS=700

# ---- Hugging Face hosted inference (alternative backend) ----
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_BASE_URL=

# ---- Database ----
DATABASE_URL=sqlite:///./data/openresearch.db

# ---- Vector store ----
VECTOR_DB_PATH=./data/chroma

# ---- Research loop ----
MAX_RESEARCH_ITERATIONS=1
MAX_SEARCH_RESULTS=5
MAX_REPORT_REVISIONS=1

# ---- Search provider (free-first: duckduckgo, optional: tavily) ----
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=