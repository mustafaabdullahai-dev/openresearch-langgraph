# ---- LLM backend ----
# "openai" = any OpenAI-compatible endpoint (default; Groq, Together, vLLM...)
# "hf"     = Hugging Face hosted inference (alternative)
LLM_PROVIDER=openai

# ---- OpenAI-compatible endpoint (defaults to Groq) ----
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3.6-27b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Per-call output cap; keep under the free-tier rate window (1000 OTPM on Groq).
OPENAI_MAX_TOKENS=900

# ---- Hugging Face hosted inference (alternative backend) ----
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_BASE_URL=