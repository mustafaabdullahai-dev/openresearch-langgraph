# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS (no wildcard with cookies).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Ollama (local LLM) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Database ----
DATABASE_URL=sqlite:///./data/openresearch.db

# ---- Vector store ----
VECTOR_DB_PATH=./data/chroma

# ---- Research loop ----
MAX_RESEARCH_ITERATIONS=3
MAX_SEARCH_RESULTS=5
MAX_REPORT_REVISIONS=2

# ---- Search provider (free-first: duckduckgo, optional: tavily) ----
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=